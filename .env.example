# REQUIRED before a real EZmob auction can happen.
# Diagnostic: Limelight generated this exact publisher endpoint. HTTP is allowed
# only for this host + path. Do not point this at any other HTTP OpenRTB URL.
EZMOB_OPENRTB_URL=http://ads-n8it6d.rtbexchanges.com/openrtb/780760269

# Limelight documents a 100 ms minimum. 500 ms is the current integration default.
EZMOB_TMAX_MS=500

# Gateway network timeout. Keep this above tmax so the exchange can answer.
EZMOB_HTTP_TIMEOUT_MS=1200

# Leave empty until EZmob confirms that the agreed $2 CPM belongs in imp.bidfloor.
EZMOB_BID_FLOOR_USD=

# App metadata. Defaults already match Grab A Toy; these are optional overrides.
APP_NAME=Grab A Toy
APP_BUNDLE=872115
APP_DOMAIN=raymobile.games
APP_STORE_URL=https://channelstore.roku.com/en-gb/details/e66e9e79ff8851a52bec86da46d73a39:8018d72e923a998f016da0daa8851f86/grab-a-toy

# Video defaults for the game's fullscreen startup / mission-5 interstitial.
VIDEO_MIN_DURATION=5
VIDEO_MAX_DURATION=60
VIDEO_MIN_BITRATE=300
VIDEO_MAX_BITRATE=12000
VIDEO_PLACEMENT=1
VIDEO_POS=7
VIDEO_PLAYBACK_METHOD=1

# Production should stay false unless you intentionally need extra safe logs.
GATEWAY_DEBUG=false
